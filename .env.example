# ==================== DeerHarness Gateway 必填配置 ====================
# 全部必填（缺失则启动失败，禁止默认口令——安全评审 P0-3）

# --- PenguinHarness 上游 ---
PENGUIN_API=http://localhost:7368
PENGUIN_USER_ID=admin
PENGUIN_PASSWORD=your-penguin-password

# --- DeerFlow 官方栈（nginx 前门）---
# DeerFlow 2.X 认证：推荐用 PAT（Personal Access Token），最小作用域：
#   threads:read runs:create runs:read（子代理同步还需用 GET/PUT/POST /api/subagents，
#   由 runs:create/threads:read 覆盖；需取消 run 才加 runs:cancel）。
#   配置 DEERFLOW_PAT 后，email/password 可省略（回退登录仅用于老部署）。
DEERFLOW_API=http://localhost:2026
# DEERFLOW_PAT=dfp_xxxxxxxxxxxxxxxx
DEERFLOW_EMAIL=admin@deerharness.com
DEERFLOW_PASSWORD=your-deerflow-password

# --- 平台 ---
# 管理员初始 API Key（首次启动自动播种；前端侧栏填入即可使用）
ADMIN_API_KEY=your-secret-admin-key

# --- 可选 ---
# CORS_ORIGINS=http://localhost:3002
# DEERFLOW_CONFIG=/path/to/deer-flow-run/config.yaml
# DEERFLOW_COMPOSE_DIR=/path/to/deer-flow

# ==================== 模型/上游 API Keys（上游服务各自使用） ====================
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# 服务端口（可选覆盖）
GATEWAY_PORT=8080
WEB_PORT=3002
